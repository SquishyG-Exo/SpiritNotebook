# ---- Server-side (Vercel project → Settings → Environment Variables) ----
# Required for live readings. Never expose this to the client.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used by /api/interpret (default: claude-opus-5).
ANTHROPIC_MODEL=
# Optional: when set, the app shows a passcode screen and /api/interpret refuses calls without it.
DEMO_PASSCODE=
# Optional rate limits (defaults shown). Best effort per serverless instance.
RATE_LIMIT_PER_IP_PER_MINUTE=8
RATE_LIMIT_PER_IP_PER_DAY=40
RATE_LIMIT_GLOBAL_PER_DAY=300
# Local development only: return a canned reading instead of calling the API. Never set in production.
MOCK_AI=

# ---- Client-side (inlined into the web bundle at build time) ----
# Leave empty on Vercel (same-origin /api). For `expo start --web` against the local API server use http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=
