# ---- Server-side (Vercel project → Settings → Environment Variables) ----
# Required for live readings. Never expose this to the client.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used by /api/interpret (default: claude-opus-5).
# It must support adaptive thinking, output_config.effort and structured outputs.
ANTHROPIC_MODEL=
# Optional: reasoning effort for readings: low | medium | high | xhigh | max (default: low).
ANTHROPIC_EFFORT=
# Optional: server-side refusal fallback (`fallbacks: "default"`) is on by default. Set to "off" to disable it.
ANTHROPIC_FALLBACKS=
# Optional: when set, the app shows a passcode screen and /api/interpret refuses calls without it.
# Use plain ASCII letters and digits: the app sends it in an HTTP header.
DEMO_PASSCODE=
# Optional rate limits (defaults shown). Best effort per serverless instance.
RATE_LIMIT_PER_IP_PER_MINUTE=8
RATE_LIMIT_PER_IP_PER_DAY=40
RATE_LIMIT_GLOBAL_PER_DAY=300
# Optional: extra origins allowed to call the API cross-origin, comma-separated.
# http://localhost:<any port> is always allowed; production is same-origin and needs nothing here.
ALLOWED_ORIGIN=
# Local development only: return a canned reading instead of calling the API. Never set in production.
# Put mock:care, mock:error or mock:slow in an entry to exercise those paths.
MOCK_AI=
# Local development only: port for `npm run dev:api` (default 3000).
PORT=

# ---- Client-side (inlined into the web bundle at build time) ----
# Leave empty on Vercel (same-origin /api). For `expo start --web` against the local API server use http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=
